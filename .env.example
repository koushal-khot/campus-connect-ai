# Copy this file to .env. Never commit the real .env.

# Long random string used to sign login sessions. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Anyone who knows this code can create an Admin account. Leave it empty
# to switch admin sign-up off completely (safest once your admins exist).
ADMIN_INVITE_CODE=

# true = new student/faculty accounts wait for admin approval before login.
# Keep false until the admin approval screen is built.
REQUIRE_APPROVAL=false

# Set to true when the site is served over HTTPS (Replit, production).
SESSION_COOKIE_SECURE=false
